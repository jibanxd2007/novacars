# ==============================================================================
# NOVA CARS — Production Environment Variables
# ==============================================================================
# Copy this file to .env.production (or add these variables in your Vercel Dashboard)
# NEVER commit your real .env file with live secrets to Git.

# 1. Database Connection (PostgreSQL for Vercel/Production)
# Compatible with Neon, Supabase, AWS RDS, Railway, or standard PostgreSQL
DATABASE_URL="postgresql://username:password@ep-host.region.neon.tech/novacars_prod?sslmode=require"

# 2. Authentication & JWT Security
# Generate a secure 32+ char key using: openssl rand -base64 32
AUTH_SECRET="your-super-secret-jwt-signing-key-minimum-32-characters"

# 3. Canonical Website URL (Used for SEO, Sitemap, OpenGraph, and Robots)
NEXT_PUBLIC_SITE_URL="https://novacars.co.nz"

# 4. Cloudinary Image Storage (Production CDN)
# Free account available at https://cloudinary.com
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
# Or alternatively use the single connection string:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# 5. Node Environment
NODE_ENV="production"
PORT=3000

# 6. Email Inquiry Notifications (Dispatches leads to support@novaauto.co.nz)
ADMIN_NOTIFICATION_EMAIL="support@novaauto.co.nz"
# SMTP credentials (Gmail App Password, Brevo, SendGrid, Amazon SES, or custom SMTP):
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-smtp-username"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM="Nova Cars Website <support@novaauto.co.nz>"
